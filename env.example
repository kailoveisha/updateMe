# Copy this file to .env.local and fill in the two values below.
# Supabase dashboard → Project Settings → API (or "Connect")

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The public "anon" key (older projects) or "publishable" key (newer projects).
# This key is meant to be public. Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL — only if you created the accounts with a different email domain.
# People sign in with a name ("kai"); the app turns that into kai@<this domain>.
# NEXT_PUBLIC_LOGIN_EMAIL_DOMAIN=updateme.local

# OPTIONAL — Cloudflare Turnstile ("verify you're human" on sign-in).
# Cloudflare dashboard → Turnstile → your widget → Site Key (public). The SECRET key goes into
# Supabase (Authentication → Attack Protection), NOT here. Leave empty to run without the check.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
